# Copy to .env and fill in your own values. .env is gitignored.

# MongoDB Atlas connection string (Week-3 Step 4.5)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Groq API key. The shared key in practical/.env is used if this is left out.
GROQ_API_KEY=paste-your-groq-api-key-here

# Chat model used for Groq calls.
GROQ_MODEL=openai/gpt-oss-120b

# Price per 1 million tokens, in USD. Leave at 0 on the free tier.
# Current rates: https://groq.com/pricing
GROQ_INPUT_PRICE_PER_MILLION=0
GROQ_OUTPUT_PRICE_PER_MILLION=0
